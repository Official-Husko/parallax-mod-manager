{
    // Parallax Mod Manager's built-in games list.

    // This file can be updated on its own (a new copy placed in this app's config directory,
    // next to this same filename) to add a game edition or tweak a field without repackaging
    // the whole app - see internal/game/gamelist.go's LoadRegistry for exactly how that works
    // and what happens if the override file is missing, corrupt, or requires a newer app
    // version than what's actually installed (it's never fatal: the app falls back to this
    // exact built-in copy and shows a notice explaining why).

    // This list's own version.
    "version": "1.0.0",
    // Minimum Parallax Mod Manager version required to safely use this file. An older running
    // app refuses to load an override copy that sets this higher than its own version, and
    // falls back to its own built-in list instead.
    "required_parallax_version": "1.0.0",
    // Where this file itself can be found, for future reference - not yet fetched
    // automatically by the app.
    "source": "https://raw.githubusercontent.com/Official-Husko/parallax-mod-manager/main/data/games.jsonc",

    "games": [
        {
            "id": "01a0963a-c214-75a3-908d-1b76b91ea7bf",
            "name": "Stellaris",
            "app_id": "281990",
            // Folder name under the Paradox user-data root (e.g. ~/.local/share/Paradox
            // Interactive/<folder_name> on Linux) - confirmed against a real install.
            "folder_name": "Stellaris",
            // "classic" (descriptor.mod) | "json_v1" | "json_v2" (Paradox Launcher JSON) -
            // see docs/paradox-mod-format.md.
            "descriptor_type": "classic",
            // Where launcher-settings.json lives, relative to the game's install directory.
            "launcher_settings_path": "launcher-settings.json",
            // Paths that must exist under a folder for it to count as a real install of this
            // game - used for install detection, unrelated to mod detection.
            "signature_files": ["launcher-settings.json"],
            // Top-level content folders that actually matter for mod conflict scanning.
            "scan_folders": [
                "common", "events", "map", "localisation", "gfx", "gui",
                "prescripted_countries", "solar_system_initializers"
            ],
            // Official DLC, so it can be listed/toggled like a mod - not built yet.
            "dlc": []
        },
        {
            "id": "01a0968a-14d2-7866-9203-a510f0bbef38",
            "name": "Crusader Kings III",
            "app_id": "1158310",
            "folder_name": "Crusader Kings III",
            "descriptor_type": "classic",
            // Nested under launcher/, unlike Stellaris - confirmed by cross-checking public
            // Paradox game data, not yet verified against a real install on this machine.
            "launcher_settings_path": "launcher/launcher-settings.json",
            "signature_files": ["launcher/launcher-settings.json"],
            "scan_folders": ["common", "events", "history", "map_data", "gui", "localization", "data_binding"],
            "dlc": []
        },
        {
            "id": "01a0968a-14d2-78b8-9552-fa6a0e588327",
            "name": "Europa Universalis IV",
            "app_id": "236850",
            "folder_name": "Europa Universalis IV",
            "descriptor_type": "classic",
            "launcher_settings_path": "launcher-settings.json",
            "signature_files": ["launcher-settings.json"],
            "scan_folders": ["common", "events", "missions", "decisions", "history", "map"],
            "dlc": []
        },
        {
            "id": "01a0968a-14d2-78be-bfe7-862417923c36",
            "name": "Hearts of Iron IV",
            "app_id": "394360",
            "folder_name": "Hearts of Iron IV",
            "descriptor_type": "classic",
            "launcher_settings_path": "launcher-settings.json",
            "signature_files": ["launcher-settings.json"],
            "scan_folders": ["common", "events", "history", "map"],
            "dlc": []
        },
        {
            "id": "01a0968a-14d2-78c1-adaa-19f9a1f2aa0d",
            "name": "Imperator: Rome",
            "app_id": "859580",
            "folder_name": "Imperator",
            "descriptor_type": "classic",
            "launcher_settings_path": "launcher/launcher-settings.json",
            "signature_files": ["launcher/launcher-settings.json"],
            "scan_folders": ["common", "events", "decisions", "gui", "localization", "map_data", "setup"],
            "dlc": []
        },
        {
            "id": "01a0968a-14d2-78c3-b405-fcfa6735e32a",
            "name": "Victoria 3",
            "app_id": "529340",
            "folder_name": "Victoria 3",
            // Victoria 3 uses the newer Paradox Launcher JSON descriptor format rather than
            // classic descriptor.mod. json_v1 is a best guess between the two relationship-
            // shape variants that format supports - not yet confirmed against a real
            // Victoria 3 install (see README's "Not yet built" list).
            "descriptor_type": "json_v1",
            "launcher_settings_path": "launcher/launcher-settings.json",
            "signature_files": ["launcher/launcher-settings.json"],
            "scan_folders": ["common", "events", "map_data", "gui", "localization"],
            "dlc": []
        }
    ]
}
