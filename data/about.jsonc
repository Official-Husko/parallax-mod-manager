// What the About page shows besides build details. This is the built-in copy;
// to change it without rebuilding, put an edited copy at
// <your config folder>/parallax-mod-manager/about.jsonc (on Linux that's
// ~/.config/parallax-mod-manager/about.jsonc) - it replaces this one entirely.
{
    // Shown as "Made by ..." at the bottom. Leave empty to hide the line.
    "author": "Official-Husko",

    // One button each, in this order.
    //   icon   Font Awesome class names. Brand logos use "fa-brands fa-<name>"
    //          (fa-github, fa-discord, fa-patreon, fa-x-twitter, fa-bluesky, ...);
    //          anything else uses "fa-solid fa-<name>".
    //   label  the button's text.
    //   url    an absolute https:// address. A link with an empty url is hidden,
    //          so a link that isn't set up yet can just be left blank.
    "links": [
        {"icon": "fa-brands fa-github", "label": "GitHub", "url": "https://github.com/Official-Husko/parallax-mod-manager"},
        {"icon": "fa-solid fa-bug", "label": "Report an issue", "url": "https://github.com/Official-Husko/parallax-mod-manager/issues"},
        {"icon": "fa-solid fa-tag", "label": "Releases", "url": "https://github.com/Official-Husko/parallax-mod-manager/releases"},

        // Not set up yet - paste an invite/profile address to show the button.
        {"icon": "fa-brands fa-discord", "label": "Discord", "url": ""}
    ]
}
